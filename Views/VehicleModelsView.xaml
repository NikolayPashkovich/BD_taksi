<UserControl x:Class="BD_taksi.Views.VehicleModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BD_taksi.Views"
             xmlns:converters="clr-namespace:BD_taksi.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и кнопок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Width="200" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Добавить" Command="{Binding AddNewCommand}" Width="80" Margin="0,0,5,0"/>
            <Button Content="Редактировать" Command="{Binding EditCommand}" Width="100" Margin="0,0,5,0"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="80" Margin="0,0,5,0"/>
        </StackPanel>

        <!-- Таблица моделей -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding VehicleModels}" 
                  SelectedItem="{Binding SelectedVehicleModel}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Класс" Binding="{Binding Class}" Width="100"/>
                <DataGridTextColumn Header="Марка" Binding="{Binding Make.Name}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма редактирования -->
        <Grid Grid.Row="2" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Background="LightGray" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Название -->
            <StackPanel Grid.Column="0" Grid.Row="0" Margin="10">
                <TextBlock Text="Название:"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Класс -->
            <StackPanel Grid.Column="1" Grid.Row="0" Margin="10">
                <TextBlock Text="Класс:"/>
                <ComboBox SelectedValue="{Binding Class}" SelectedValuePath="Tag">
                    <ComboBoxItem Content="Economy" Tag="Economy"/>
                    <ComboBoxItem Content="Comfort" Tag="Comfort"/>
                    <ComboBoxItem Content="Business" Tag="Business"/>
                </ComboBox>
            </StackPanel>

            <!-- Марка -->
            <StackPanel Grid.Column="0" Grid.Row="1" Margin="10">
                <TextBlock Text="Марка:"/>
                <ComboBox ItemsSource="{Binding VehicleMakes}" 
                         SelectedValue="{Binding MakeId}"
                         DisplayMemberPath="Name"
                         SelectedValuePath="Id"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="80" Margin="0,0,5,0"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Width="80"/>
            </StackPanel>
        </Grid>

        <!-- Индикатор загрузки -->
        <Grid Grid.Row="1" Background="White" Opacity="0.7" 
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Загрузка..." HorizontalAlignment="Center" VerticalAlignment="Center" 
                       FontSize="16" FontWeight="Bold"/>
        </Grid>
    </Grid>
</UserControl>
