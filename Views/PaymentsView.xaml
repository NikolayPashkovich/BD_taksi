<UserControl x:Class="BD_taksi.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BD_taksi.Views"
             xmlns:converters="clr-namespace:BD_taksi.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и кнопок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Width="200" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Добавить" Command="{Binding AddNewCommand}" Width="80" Margin="0,0,5,0"/>
            <Button Content="Редактировать" Command="{Binding EditCommand}" Width="100" Margin="0,0,5,0"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="80" Margin="0,0,5,0"/>
        </StackPanel>

        <!-- Таблица платежей -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Payments}" 
                  SelectedItem="{Binding SelectedPayment}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Customer.FullName}" Width="150"/>
                <DataGridTextColumn Header="Способ оплаты" Binding="{Binding Method.Name}" Width="120"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма редактирования -->
        <Grid Grid.Row="2" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Background="LightGray" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Клиент -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="10">
                <TextBlock Text="Клиент:"/>
                <ComboBox ItemsSource="{Binding Customers}" 
                         SelectedValue="{Binding CustomerId}"
                         DisplayMemberPath="FullName"
                         SelectedValuePath="Id"/>
            </StackPanel>

            <!-- Способ оплаты -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
                <TextBlock Text="Способ оплаты:"/>
                <ComboBox ItemsSource="{Binding PaymentMethods}" 
                         SelectedValue="{Binding MethodId}"
                         DisplayMemberPath="Name"
                         SelectedValuePath="Id"/>
            </StackPanel>

            <!-- Сумма -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
                <TextBlock Text="Сумма:"/>
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Дата -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
                <TextBlock Text="Дата:"/>
                <DatePicker SelectedDate="{Binding Date}"/>
            </StackPanel>

            <!-- Статус -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="10">
                <TextBlock Text="Статус:"/>
                <ComboBox SelectedItem="{Binding Status}">
                    <ComboBoxItem Content="Pending"/>
                    <ComboBoxItem Content="Completed"/>
                    <ComboBoxItem Content="Failed"/>
                </ComboBox>
            </StackPanel>

            <!-- Поездка -->
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10">
                <TextBlock Text="Поездка:"/>
                <ComboBox ItemsSource="{Binding Rides}" 
                         SelectedValue="{Binding RideId}"
                         DisplayMemberPath="Id"
                         SelectedValuePath="Id"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="10">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="80" Margin="0,0,5,0"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Width="80"/>
            </StackPanel>
        </Grid>

        <!-- Индикатор загрузки -->
        <Grid Grid.Row="1" Background="White" Opacity="0.7" 
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Загрузка..." HorizontalAlignment="Center" VerticalAlignment="Center" 
                       FontSize="16" FontWeight="Bold"/>
        </Grid>
    </Grid>
</UserControl>
