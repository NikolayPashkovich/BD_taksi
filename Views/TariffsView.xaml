<UserControl x:Class="BD_taksi.Views.TariffsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BD_taksi.Views"
             xmlns:converters="clr-namespace:BD_taksi.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и кнопок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Width="200" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="Добавить" Command="{Binding AddNewCommand}" Width="80" Margin="0,0,5,0"/>
            <Button Content="Редактировать" Command="{Binding EditCommand}" Width="100" Margin="0,0,5,0"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Width="80" Margin="0,0,5,0"/>
        </StackPanel>

        <!-- Таблица тарифов -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Tariffs}" 
                  SelectedItem="{Binding SelectedTariff}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Базовая стоимость" Binding="{Binding BaseFare, StringFormat=C}" Width="150"/>
                <DataGridTextColumn Header="Стоимость за км" Binding="{Binding PricePerKm, StringFormat=C}" Width="150"/>
                <DataGridTextColumn Header="Стоимость за минуту" Binding="{Binding PricePerMinute, StringFormat=C}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма редактирования -->
        <Grid Grid.Row="2" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" 
              Background="LightGray" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Название -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="10">
                <TextBlock Text="Название:"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Базовая стоимость -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
                <TextBlock Text="Базовая стоимость:"/>
                <TextBox Text="{Binding BaseFare, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Стоимость за км -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
                <TextBlock Text="Стоимость за км:"/>
                <TextBox Text="{Binding PricePerKm, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Стоимость за минуту -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
                <TextBlock Text="Стоимость за минуту:"/>
                <TextBox Text="{Binding PricePerMinute, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="10">
                <Button Content="Сохранить" Command="{Binding SaveCommand}" Width="80" Margin="0,0,5,0"/>
                <Button Content="Отмена" Command="{Binding CancelCommand}" Width="80"/>
            </StackPanel>
        </Grid>

        <!-- Индикатор загрузки -->
        <Grid Grid.Row="1" Background="White" Opacity="0.7" 
              Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Загрузка..." HorizontalAlignment="Center" VerticalAlignment="Center" 
                       FontSize="16" FontWeight="Bold"/>
        </Grid>
    </Grid>
</UserControl>
